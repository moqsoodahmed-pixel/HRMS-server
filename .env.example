PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dutylaunch-hrms
# Signing key for session JWTs. Must be at least 32 random characters — the
# server refuses to start otherwise (see config/env.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Uploads are written under this directory (kept outside the web root)
UPLOAD_DIR=uploads

# AES-256-GCM key for identity-document encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional: outbound mail (password reset / welcome mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DutyLaunch HRMS <noreply@dutylaunch.com>

# Seed credentials
SEED_ADMIN_PASSWORD=Admin@123456
SEED_EMPLOYEE_PASSWORD=Employee@123456

# Optional override for the API rate limit (requests / 15 min)
RATE_LIMIT_MAX=
