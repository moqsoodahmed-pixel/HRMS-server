# --- Core ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/dutylaunch-hrms

# --- Security (required, no fallback — see config/env.js) ---
JWT_SECRET=replace-with-a-long-random-value-at-least-32-characters
ENCRYPTION_KEY=replace-with-64-hex-characters-a-256-bit-key

# --- CORS / cookies ---
# The frontend's exact origin(s), comma-separated if there is more than one
# (e.g. a staging and a production frontend). Never '*' — CORS with
# credentials requires an exact match. Must be the ACTUAL deployed frontend
# origin, protocol included, no trailing slash.
CLIENT_URL=http://localhost:5173

# On Render, you normally do NOT need to set this at all: Render
# automatically provides RENDER_EXTERNAL_URL for every web service, and the
# app compares its hostname against CLIENT_URL to detect a cross-site
# deployment (e.g. a Cloudflare Pages / separate static-site frontend calling
# a *.onrender.com backend) on its own. Set this explicitly only to override
# that, or when not running on Render.
#   true  -> SameSite=None; Secure (required for a genuinely cross-site
#            frontend/backend — without this, login succeeds but every
#            following request 401s because the browser silently withholds a
#            SameSite=Lax cookie from cross-site fetch/XHR calls)
#   false -> SameSite=Lax (frontend and backend share an origin: one service
#            serving both, or the Vite dev proxy in local development)
# COOKIE_CROSS_SITE=true

# --- Session duration (optional — defaults shown) ---
JWT_SESSION_EXPIRES_IN=30m
JWT_REMEMBER_EXPIRES_IN=7d

# --- Email (password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=replace-with-an-app-password

# --- Seed / demo passwords (dev only) ---
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

UPLOAD_DIR=uploads
